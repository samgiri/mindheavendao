# Required to enable WalletConnect and Trust Wallet QR sessions.
# Create a project at https://cloud.reown.com and allowlist deployment origins.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional public BNB Smart Chain Testnet RPC endpoint.
# Leave empty to use viem's public default transport.
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=

# Public origin used in wallet connection metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
